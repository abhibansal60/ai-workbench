#!/usr/bin/env bash
# t3-sync-update [host...]  (default: the hosts in $T3_HOSTS, e.g. export T3_HOSTS="maxi mini")
# Unattended "Update everything": run `t3 update -y` on every host (each stays on its own channel),
# then check every server reports the version its `t3` is on, and that all hosts match.
# From the app, the sidebar update button does the same by hand (providers, servers, desktop app).
# T3 itself refuses an update that would cross channels into an incompatible database; switch
# channels from Settings → About → Update track, not here.
# An unreachable host is skipped (the rest still update) and the run fails. With T3_ALERT=1 (the timer
# sets it) a failed run opens or comments on a GitHub issue "t3-sync-update failed" in T3_ALERT_REPO
# (default abhibansal60/ai-workbench), and a clean run closes it.
set -euo pipefail

alert_repo=${T3_ALERT_REPO:-abhibansal60/ai-workbench}
alert_title="t3-sync-update failed"
alert() {
  rc=$?
  [ "${T3_ALERT:-0}" = 1 ] || return 0
  n=$(gh issue list -R "$alert_repo" --state open --search "\"$alert_title\" in:title" --json number -q '.[0].number' 2>/dev/null || true)
  if [ $rc = 0 ]; then
    [ -z "$n" ] || gh issue close "$n" -R "$alert_repo" --comment "Ok again on $(hostname) at $(date -Is)." >/dev/null 2>&1 || true
    return 0
  fi
  body="Run on $(hostname) at $(date -Is) exited $rc. Details: \`journalctl --user -u t3-sync-update -n 40\` on $(hostname)."
  if [ -n "$n" ]; then gh issue comment "$n" -R "$alert_repo" --body "$body" >/dev/null 2>&1 || true
  else gh issue create -R "$alert_repo" --title "$alert_title" --body "$body" >/dev/null 2>&1 || true; fi
}
trap alert EXIT

port=${T3_PORT:-3773}
hosts=("$@"); [ ${#hosts[@]} -gt 0 ] || read -ra hosts <<< "${T3_HOSTS:-}"
[ ${#hosts[@]} -gt 0 ] || { echo "usage: t3-sync-update host... (or set T3_HOSTS)" >&2; exit 2; }

on_host() { if [ "$1" = "$(hostname)" ]; then bash -c "$2"; else ssh -o ConnectTimeout=20 -o BatchMode=yes "$1" "$2"; fi; }

# Skip hosts that don't answer, so one sleeping laptop doesn't block the other or read as "no t3".
live=(); down=()
for h in "${hosts[@]}"; do
  if on_host "$h" true 2>/dev/null; then live+=("$h"); else down+=("$h"); fi
done
[ ${#live[@]} -gt 0 ] || { echo "FAIL no host reachable: ${down[*]}" >&2; exit 1; }
hosts=("${live[@]}")

# Keep successful units loaded too: otherwise systemd can discard their exit status.
# Use our exact unit names so another updater's work cannot affect this run.
status=0
units=(); updated=()
run_id="$(date +%s)-$$"
for h in "${hosts[@]}"; do
  unit="t3-sync-update-$run_id-${#units[@]}.service"
  if on_host "$h" "systemd-run --user --property=RemainAfterExit=yes --unit=$unit bash -c 't3 update -y >>\$HOME/.t3/sync-update.log 2>&1'" >/dev/null; then
    units+=("$unit")
  else
    echo "FAIL $h could not launch update"
    units+=(""); status=1
  fi
done

echo "waiting for updates to finish..."
for i in "${!hosts[@]}"; do
  h=${hosts[$i]}; unit=${units[$i]}
  [ -n "$unit" ] || continue
  finished=0
  for _ in $(seq 60); do
    if ! state=$(on_host "$h" "systemctl --user show $unit -p ActiveState --value"); then
      echo "FAIL $h cannot inspect $unit"; status=1; break
    fi
    case "$state" in
      activating|active|deactivating)
        # RemainAfterExit leaves a successful update active (exited).
        if [ "$state" != active ] || [ "$(on_host "$h" "systemctl --user show $unit -p SubState --value")" != exited ]; then
          sleep 5; continue
        fi ;;
    esac
    finished=1
    break
  done
  if [ "$finished" = 0 ]; then
    echo "FAIL $h update timed out or could not be inspected ($unit)"; status=1
  elif result=$(on_host "$h" "systemctl --user show $unit -p Result -p ExecMainCode -p ExecMainStatus") &&
       grep -qx 'Result=success' <<< "$result" &&
       grep -qx 'ExecMainCode=1' <<< "$result" &&
       grep -qx 'ExecMainStatus=0' <<< "$result"; then
    updated+=("$h")
  else
    echo "FAIL $h update failed ($unit): ${result:-no exit status}"; status=1
  fi
  # Collect only after inspection; on timeout this also stops the pending update.
  on_host "$h" "systemctl --user stop $unit && { systemctl --user reset-failed $unit 2>/dev/null || true; }" || status=1
done
hosts=("${updated[@]}")

version_of() { curl -fsS -m 5 "http://$1:$port/.well-known/t3/environment" 2>/dev/null | jq -r .serverVersion 2>/dev/null || true; }

# Each server must run its own `t3` version (a stale service unit shows up here), and all must match.
seen=""
for h in "${down[@]}"; do echo "FAIL $h unreachable"; status=1; done
for _ in $(seq 12); do  # the service takes a few seconds to come back
  [ ${#hosts[@]} -gt 0 ] || break
  [ -n "$(version_of "${hosts[0]}")" ] && break; sleep 5
done
for h in "${hosts[@]}"; do
  v=$(version_of "$h")
  want=$(on_host "$h" 't3 --version' | awk '{print $2}'); want=${want#v}
  if [ -n "$v" ] && [ "$v" = "$want" ]; then echo "OK   $h $v"; else echo "FAIL $h server ${v:-unreachable}, t3 $want"; status=1; continue; fi
  seen+="$v "
  # Keep the desktop app on the service's version, then repair what a release can break (see t3-doctor).
  after="if [ -e ~/Applications/t3code-app ]; then ~/.local/bin/t3-desktop-update $v || exit 1; fi; ~/.local/bin/t3-doctor --fix"
  on_host "$h" "$after" || status=1
done
[ "$(printf '%s\n' $seen | sort -u | wc -l)" -le 1 ] || { echo "FAIL hosts run different versions: $seen"; status=1; }
exit $status
