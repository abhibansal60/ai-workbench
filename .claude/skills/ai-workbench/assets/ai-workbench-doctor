#!/usr/bin/env bash
# ai-workbench-doctor — reports what's installed/configured vs missing for the
# AI Workbench skill. Safe to run any time; makes no changes.

purple='\033[1;38;2;157;75;255m'
green='\033[1;38;2;57;255;20m'
red='\033[1;38;2;255;0;60m'
cyan='\033[38;2;0;255;249m'
grey='\033[38;2;92;92;110m'
reset='\033[0m'

ok_count=0
total_count=0

strip_ansi() { sed -E 's/\x1b\[[0-9;]*m//g' <<< "$1"; }
ok()   { printf "  ${green}✓${reset} %-28s ${grey}%s${reset}\n" "$1" "$(strip_ansi "$2")"; ok_count=$((ok_count+1)); total_count=$((total_count+1)); }
miss() { printf "  ${red}✗${reset} %-28s ${grey}%s${reset}\n" "$1" "$(strip_ansi "$2")"; total_count=$((total_count+1)); }
section() { echo ""; echo -e "${cyan}$1${reset}"; }

has() { command -v "$1" >/dev/null 2>&1; }

echo -e "${purple}┌─ ai-workbench-doctor ─────────────────────────────────────${reset}"

section "Editor"
if has code; then ok "VS Code" "$(code --version 2>/dev/null | head -1)"; else miss "VS Code" "not on PATH"; fi

section "Prompt & font"
if has starship; then ok "Starship" "$(starship --version 2>/dev/null | head -1)"; else miss "Starship" "not on PATH"; fi
if [ -f ~/.config/starship.toml ]; then
    if grep -q 'palette = "ai-workbench"' ~/.config/starship.toml 2>/dev/null; then
        ok "starship.toml" "ai-workbench palette active"
    else
        ok "starship.toml" "present, but not the ai-workbench palette"
    fi
else
    miss "starship.toml" "~/.config/starship.toml not found"
fi
if fc-list 2>/dev/null | grep -qiE "JetBrainsMono Nerd Font(,|:)"; then
    ok "Nerd Font" "JetBrainsMono Nerd Font registered"
else
    miss "Nerd Font" "not found via fc-list"
fi
if fc-list 2>/dev/null | grep -qi "JetBrainsMono Nerd Font Mono"; then
    miss "Nerd Font (bad variant)" "the broken 'Mono' patch is ALSO installed — remove it, it breaks letter-spacing in VTE terminals"
fi
if has gsettings && gsettings list-schemas 2>/dev/null | grep -q "^org.gnome.Ptyxis$"; then
    pfont=$(gsettings get org.gnome.Ptyxis font-name 2>/dev/null | tr -d "'")
    if [ "$(gsettings get org.gnome.Ptyxis use-system-font 2>/dev/null)" = "true" ]; then
        ok "Ptyxis font" "system font, $(gsettings get org.gnome.desktop.interface monospace-font-name 2>/dev/null | tr -d "'") (icons fall back to the Nerd Font)"
    elif [[ "$pfont" == "JetBrainsMono Nerd Font "* ]]; then
        ok "Ptyxis font" "$pfont (wider than the system font)"
    else
        miss "Ptyxis font" "$pfont has no Nerd Font icons — use the system font (see SKILL.md)"
    fi
    # Ptyxis keeps one background process for every window. If it started before
    # the font was installed, every new tab and window draws over-wide cells.
    font_file=~/.local/share/fonts/JetBrainsMonoNerdFont/JetBrainsMonoNerdFont-Regular.ttf
    svc_pid=$(pgrep -of 'ptyxis --gapplication-service')
    if [ -n "$svc_pid" ] && [ -f "$font_file" ]; then
        svc_start=$(( $(date +%s) - $(ps -o etimes= -p "$svc_pid" | tr -d ' ') ))
        if [ "$svc_start" -lt "$(stat -c %Y "$font_file")" ]; then
            miss "Ptyxis restart" "running since before the font install — close every window, then: pkill -f 'ptyxis --gapplication-service'"
        else
            ok "Ptyxis restart" "started after the font install"
        fi
    fi
fi

section "Terminal palette"
if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q "^org.gnome.Ptyxis$"; then
    uuid=$(gsettings get org.gnome.Ptyxis default-profile-uuid 2>/dev/null | tr -d "'")
    if [ -n "$uuid" ]; then
        palette=$(gsettings get "org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$uuid/" palette 2>/dev/null | tr -d "'")
        if [ "$palette" = "AI Workbench" ]; then
            ok "Ptyxis palette" "AI Workbench active on default profile"
        else
            miss "Ptyxis palette" "profile palette is '$palette', not AI Workbench"
        fi
    fi
else
    miss "Ptyxis palette" "Ptyxis not detected — palette is terminal-specific, set up manually for your terminal"
fi

plugin_enabled() {
    [ -f ~/.claude/settings.json ] && python3 -c "
import json, sys
d = json.load(open('$HOME/.claude/settings.json'))
sys.exit(0 if any(k.startswith('$1@') and v for k, v in d.get('enabledPlugins', {}).items()) else 1)
" 2>/dev/null
}

section "Claude Code"
if has claude; then ok "claude" "$(claude --version 2>/dev/null | head -1)"; else miss "claude" "not on PATH — curl -fsSL https://claude.ai/install.sh | bash"; fi
if has jq; then ok "jq" "$(jq --version 2>/dev/null) (status line and usage stop need it)"; else miss "jq" "not on PATH — the status line renders blank without it"; fi
if [ -f ~/.claude/statusline.sh ]; then ok "statusline.sh" "present"; else miss "statusline.sh" "~/.claude/statusline.sh not found"; fi
if [ -f ~/.claude/statusline-tokens.mjs ] && has node; then
    ok "session token totals" "statusline-tokens.mjs + node $(node --version 2>/dev/null)"
else
    miss "session token totals" "needs node and ~/.claude/statusline-tokens.mjs (segment is skipped)"
fi
if [ -f ~/.claude/hooks/usage-stop.sh ]; then
    if grep -q 'usage-stop.sh' ~/.claude/settings.json 2>/dev/null; then
        ok "usage hard stop" "PreToolUse hook wired, stops at 75% of the 5h limit"
    else
        miss "usage hard stop" "usage-stop.sh present but not wired as a PreToolUse hook"
    fi
else
    miss "usage hard stop" "optional — not installed"
fi
if [ -f ~/.claude/settings.json ] && python3 -c "import json,sys; d=json.load(open('$HOME/.claude/settings.json')); sys.exit(0 if 'statusLine' in d else 1)" 2>/dev/null; then
    ok "statusLine config" "wired in ~/.claude/settings.json"
else
    miss "statusLine config" "no statusLine key in ~/.claude/settings.json"
fi
# Only relevant once the daily.dev plugin is enabled — it supplies the
# second sub-script statusline-combined.sh fans out to.
if plugin_enabled "daily.dev"; then
    if [ -f ~/.claude/statusline-combined.sh ]; then
        ok "statusline-combined.sh" "present (daily.dev headlines wired in)"
    else
        miss "statusline-combined.sh" "daily.dev enabled but combined statusline not set up — run daily.dev's statusline skill"
    fi
fi

section "Modern CLI tools"
for t in eza bat fzf zoxide; do
    if has "$t"; then ok "$t" "$($t --version 2>/dev/null | head -1)"; else miss "$t" "not on PATH"; fi
done

section "git delta"
if has delta; then ok "delta" "$(delta --version 2>/dev/null)"; else miss "delta" "not on PATH"; fi
if [ "$(git config --get core.pager 2>/dev/null)" = "delta" ]; then
    if has delta; then ok "git core.pager" "set to delta"
    else miss "git core.pager" "set to delta, but delta isn't installed — paged git output fails"; fi
else
    miss "git core.pager" "not set to delta"
fi

section "Zellij"
if has zellij; then ok "zellij" "$(zellij --version 2>/dev/null)"; else miss "zellij" "not on PATH"; fi
if [ -f ~/.config/zellij/config.kdl ] && grep -q 'theme "ai-workbench"' ~/.config/zellij/config.kdl 2>/dev/null; then
    ok "zellij config" "ai-workbench theme active"
else
    miss "zellij config" "~/.config/zellij/config.kdl missing or not themed"
fi

section "btop"
if has btop; then ok "btop" "$(btop --version 2>/dev/null | head -1)"; else miss "btop" "not on PATH"; fi
if [ -f ~/.config/btop/themes/ai-workbench.theme ]; then ok "btop theme file" "present"; else miss "btop theme file" "~/.config/btop/themes/ai-workbench.theme not found"; fi
if [ -f ~/.config/btop/btop.conf ] && grep -q 'color_theme = "ai-workbench"' ~/.config/btop/btop.conf 2>/dev/null; then
    ok "btop.conf" "color_theme = ai-workbench"
else
    miss "btop.conf" "color_theme not set to ai-workbench"
fi

section "Shell aliases"
if [ -f ~/.bash_aliases ] && grep -q "devhelp" ~/.bash_aliases 2>/dev/null; then
    ok "~/.bash_aliases" "present, devhelp/dh available"
else
    miss "~/.bash_aliases" "missing or doesn't have devhelp"
fi
if grep -q "bash_aliases" ~/.bashrc 2>/dev/null; then
    ok "~/.bashrc sourcing" "sources ~/.bash_aliases"
else
    miss "~/.bashrc sourcing" "~/.bashrc doesn't source ~/.bash_aliases"
fi

section "GitHub CLI"
if has gh; then
    ok "gh" "$(gh --version 2>/dev/null | head -1)"
    if gh auth status >/dev/null 2>&1; then
        ok "gh auth" "authenticated"
    else
        miss "gh auth" "not logged in — run: gh auth login"
    fi
else
    miss "gh" "not on PATH"
fi
# A credential helper copied from another machine can point at a gh that isn't here.
gh_helper=$(git config --global --get-all credential.https://github.com.helper 2>/dev/null | grep -o '![^ ]*gh' | head -1)
if [ -n "$gh_helper" ]; then
    if [ -x "${gh_helper#!}" ] || has "${gh_helper#!}"; then
        ok "git credential helper" "${gh_helper#!}"
    else
        miss "git credential helper" "${gh_helper#!} is missing — HTTPS push/pull to GitHub fails"
    fi
fi

section "Node.js"
if has node; then ok "node" "$(node --version 2>/dev/null)"; else miss "node" "not on PATH — status-line tokens, daily.dev line, npx and some plugins need it"; fi
if has npm; then ok "npm" "$(npm --version 2>/dev/null)"; else miss "npm" "not on PATH"; fi

section "Clipboard"
if [ -n "$WAYLAND_DISPLAY" ] || [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    if has wl-copy && has wl-paste; then ok "wl-clipboard" "$(wl-copy --version 2>/dev/null | head -1)"
    else miss "wl-clipboard" "missing — Claude Code can't paste images; see SKILL.md"; fi
fi
if has xclip; then ok "xclip" "$(xclip -version 2>&1 | head -1) (X11 and XWayland apps)"
else miss "xclip" "missing — needed on X11; see SKILL.md"; fi

section "Claude Code plugins (optional)"
for p in mattpocock-skills daily.dev ponytail caveman humanizer; do
    if plugin_enabled "$p"; then
        ok "$p" "enabled"
    else
        miss "$p" "not installed — optional, see SKILL.md"
    fi
done

section "Tailscale (optional)"
if has tailscale; then
    ok "tailscale" "$(tailscale version 2>/dev/null | head -1)"
    ts_ip=$(tailscale ip -4 2>/dev/null | head -1)
    if [ -n "$ts_ip" ]; then
        ok "tailnet" "up, $ts_ip"
    else
        miss "tailnet" "no tailnet IP — run: sudo tailscale up"
    fi
else
    miss "tailscale" "not installed — optional, needs sudo, see SKILL.md"
fi

section "T3 Code (optional)"
if has t3; then
    ok "t3" "$(t3 --version 2>/dev/null | head -1)"
    if systemctl --user is-active --quiet t3code.service 2>/dev/null; then
        ok "t3code.service" "active"
    else
        miss "t3code.service" "not running — run: t3 service status"
    fi
    if grep -qs 'T3CODE_TELEMETRY_ENABLED=false' ~/.config/systemd/user/t3code.service.d/*.conf; then
        ok "T3 telemetry" "off (systemd drop-in)"
    else
        miss "T3 telemetry" "no T3CODE_TELEMETRY_ENABLED=false drop-in"
    fi
    # Expected bind: the tailnet IP when tailscale is up, else loopback.
    want_host=$(tailscale ip -4 2>/dev/null | head -1); want_host=${want_host:-127.0.0.1}
    t3_host=$(python3 -c "import json; print(json.load(open('$HOME/.t3/userdata/server-runtime.json'))['host'])" 2>/dev/null)
    if [ "$t3_host" = "$want_host" ]; then
        ok "T3 bind address" "$t3_host"
    else
        miss "T3 bind address" "bound to '${t3_host:-unknown}', expected $want_host"
    fi
    t3_default=$(python3 -c "import json; print(json.load(open('$HOME/.t3/userdata/settings.json'))['defaultModelSelection']['instanceId'])" 2>/dev/null)
    if [ "$t3_default" = "claudeAgent" ]; then
        ok "T3 default provider" "Claude"
    else
        miss "T3 default provider" "'${t3_default:-unset}' — pick a Claude model as default in Settings"
    fi
    t3_projects=$(python3 -c "
import sqlite3
c = sqlite3.connect('file:$HOME/.t3/userdata/state.sqlite?mode=ro', uri=True)
print(c.execute('select count(*) from projection_projects where deleted_at is null').fetchone()[0])" 2>/dev/null)
    if [ "${t3_projects:-0}" -gt 0 ]; then
        ok "T3 projects" "$t3_projects added"
    else
        miss "T3 projects" "none — run: t3 project add <path>"
    fi
else
    miss "t3" "not installed — optional, see SKILL.md"
fi

section "Dock (optional, GNOME)"
if has gsettings && gsettings list-schemas 2>/dev/null | grep -q "^org.gnome.shell$"; then
    favs=$(gsettings get org.gnome.shell favorite-apps 2>/dev/null | tr -d "[]'" | sed 's/\.desktop//g')
    ok "pinned apps" "${favs:-none}"
fi

section "Always-on host (optional)"
if has gsettings; then
    ac_sleep=$(gsettings get org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 2>/dev/null | tr -d "'")
    if [ "$ac_sleep" = "nothing" ]; then ok "sleep on AC" "never"; else miss "sleep on AC" "'${ac_sleep:-unknown}' — box sleeps when idle"; fi
    bat_sleep=$(gsettings get org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 2>/dev/null | tr -d "'")
    ok "sleep on battery" "${bat_sleep:-unknown} (either is fine; 'nothing' keeps it reachable unplugged)"
fi
lid=$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager HandleLidSwitch 2>/dev/null | awk '{print $2}' | tr -d '"')
if [ "$lid" = "ignore" ]; then ok "lid close" "ignored"
elif [ -f /etc/systemd/logind.conf.d/always-on.conf ]; then miss "lid close" "'$lid' until the next reboot (config is in place)"
else miss "lid close" "'${lid:-unknown}' — closing the lid sleeps the box"; fi
if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" = "yes" ]; then ok "linger" "user services run without login"
else miss "linger" "off — T3 stops at logout"; fi
if [ "$(systemctl is-enabled suspend.target 2>/dev/null)" = "masked" ]; then ok "suspend" "masked — nothing can sleep the box"
else miss "suspend" "not masked — a menu click or D-Bus call can still sleep the box"; fi
if has nmcli; then
    wifi=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1; exit}')
    if [ -n "$wifi" ]; then
        if [ "$(nmcli -g 802-11-wireless-security.psk-flags con show "$wifi" 2>/dev/null)" = "1" ]; then
            miss "Wi-Fi before login" "'$wifi' password is in the keyring — tick 'Make available to other users'"
        else
            ok "Wi-Fi before login" "$wifi"
        fi
    fi
fi

section "Voice typing (optional)"
if has handy; then
    hs=~/.local/share/com.pais.handy/settings_store.json
    model=$(jq -r '.settings.selected_model // empty' "$hs" 2>/dev/null)
    ok "handy" "model ${model:-unknown}"
    if [ "$(jq -r '.settings.overlay_style // empty' "$hs" 2>/dev/null)" = "none" ]; then ok "overlay" "off (an overlay steals the paste on GNOME)"
    else miss "overlay" "on — on GNOME it takes focus and the paste is lost"; fi
    if systemctl --user is-active --quiet ydotool 2>/dev/null; then ok "ydotool" "running"; else miss "ydotool" "not running — pasting fails"; fi
    if [ -w /dev/uinput ]; then ok "/dev/uinput" "writable"; else miss "/dev/uinput" "not writable — udev rule or input group missing (re-login?)"; fi
    if gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings 2>/dev/null | grep -q handy; then
        ok "shortcut" "$(gsettings get org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/handy/ binding 2>/dev/null)"
    else miss "shortcut" "no GNOME shortcut runs handy --toggle-transcription"; fi
else
    miss "handy" "not installed — optional, see SKILL.md"
fi

section "Remote desktop (optional)"
if has grdctl && [ "$(systemctl --user is-active gnome-remote-desktop 2>/dev/null)" = "active" ]; then
    ok "sharing this desktop" "RDP on port 3389"
else
    miss "sharing this desktop" "off — optional, see SKILL.md"
fi
if has remmina; then
    ok "remmina" "$(ls ~/.local/share/remmina/*.remmina 2>/dev/null | wc -l) saved connection(s)"
else
    miss "remmina" "not installed — needed only to open another machine's desktop"
fi

echo ""
echo -e "${purple}└────────────────────────────────────────────────────────${reset}"
echo -e "${grey}${ok_count}/${total_count} checks passed${reset}"
